# Cabeceras de seguridad de dreamcodestudio.app (Cloudflare Pages las aplica solas).
# Este archivo debe llamarse exactamente _headers, sin extensión, y estar en la carpeta principal.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; media-src 'self' https://pub-302795f288b64828bf5c0c69ad1fa470.r2.dev https://audio.dreamcodestudio.app; frame-src https://www.youtube-nocookie.com; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Las tipografías no cambian: el navegador puede guardarlas un año
/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable
